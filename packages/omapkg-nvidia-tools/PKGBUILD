  install -Dm755 vendor-root/nvidia-smi ${pkgdir}/usr/bin/nvidia-smi
  install -Dm755 vendor-root/libnvidia-ml.so.${pkgver} ${pkgdir}/usr/lib/libnvidia-ml.so.${pkgver}
