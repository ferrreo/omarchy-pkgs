build() {
  cd "$srcdir"
  set -eu
  source="$srcdir/NVIDIA-Linux-x86_64-610.57.04.run"
  destination="$srcdir/vendor-root"
  printf '%s  %s\n' 'b2e935c66b83bb00c0c857bc8e0ee0fd52de9286b40c9cc1eec29a7ce7eb116d' "$source" | sha256sum -c -
  rm -rf "$destination"
