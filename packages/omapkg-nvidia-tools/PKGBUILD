# Generated by omapkg factory. Review before build.
pkgname='omapkg-nvidia-tools'
pkgver='610.57.04'
pkgrel=4
pkgdesc='NVIDIA proprietary graphics driver userland tools (nvidia-smi, nvidia-modprobe, nvidia-xconfig) for Linux x86_64.'
arch=('x86_64')
license=('LicenseRef-NVIDIA-EULA')
depends=('libglvnd' 'libx11' 'libxext' 'libgl' 'zlib' 'libvulkan.so')
makedepends=()
source=('NVIDIA-Linux-x86_64-610.57.04.run::https://download.nvidia.com/XFree86/Linux-x86_64/610.57.04/NVIDIA-Linux-x86_64-610.57.04.run')
sha256sums=('b2e935c66b83bb00c0c857bc8e0ee0fd52de9286b40c9cc1eec29a7ce7eb116d')

build() {
  cd "$srcdir"
  set -eu
  source="$srcdir/NVIDIA-Linux-x86_64-610.57.04.run"
  destination="$srcdir/vendor-root"
  printf '%s  %s\n' 'b2e935c66b83bb00c0c857bc8e0ee0fd52de9286b40c9cc1eec29a7ce7eb116d' "$source" | sha256sum -c -
  rm -rf "$destination"
  sh "$source" --extract-only --target "$destination"
  [ "$(ls -A .)" ] || { echo "vendor-root is empty"; exit 1; }
  # Source ships precompiled proprietary binaries; no compilation step required.
  # Build phase only confirms the verified vendor extraction is non-empty and ready for staging.
}

package() {
  cd "$srcdir"
  # Install userland driver tools
  install -d "$pkgdir/usr/bin"
  for tool in nvidia-smi nvidia-modprobe nvidia-persistenced nvidia-xconfig nvidia-settings; do
  [ -f "$tool" ] && install -m755 "$tool" "$pkgdir/usr/bin/"
  done
  # Install shared libraries required by userland tools
  install -d "$pkgdir/usr/lib"
  for lib in libnvidia-ml.so.* libnvidia-cfg.so.* libnvidia-ptxjitcompiler.so.* libnvidia-egl-wayland.so.*; do
  [ -f "$lib" ] && install -m755 "$lib" "$pkgdir/usr/lib/"
  done
  # Install OpenCL ICD
  install -d "$pkgdir/etc/OpenCL/vendors"
  [ -f nvidia.icd ] && install -m644 nvidia.icd "$pkgdir/etc/OpenCL/vendors/"
  # Install Vulkan ICD
  install -d "$pkgdir/etc/vulkan/icd.d"
  [ -f nvidia_icd.json ] && install -m644 nvidia_icd.json "$pkgdir/etc/vulkan/icd.d/"
  # Install udev rules
  install -d "$pkgdir/usr/lib/udev/rules.d"
  [ -f nvidia-udev.rules ] && install -m644 nvidia-udev.rules "$pkgdir/usr/lib/udev/rules.d/70-nvidia.rules"
  # Install man pages
  install -d "$pkgdir/usr/share/man/man1"
  [ -d man ] && find man -name '*.1' -exec install -m644 {} "$pkgdir/usr/share/man/man1/" \;
  # Install documentation
  install -d "$pkgdir/usr/share/doc/nvidia"
  [ -f README.txt ] && install -m644 README.txt "$pkgdir/usr/share/doc/nvidia/"
  [ -f LICENSE ] && install -m644 LICENSE "$pkgdir/usr/share/doc/nvidia/"
}
