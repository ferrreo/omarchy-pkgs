pkgdesc='GNU Hello prints friendly greeting messages and serves as a canonical example of a GNU package layout, build, and i18n workflow.'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('autoconf' 'automake' 'gettext' 'perl' 'texinfo' 'help2man')
source=('hello-2.12.tar.gz::https://ftp.gnu.org/gnu/hello/hello-2.12.tar.gz')
